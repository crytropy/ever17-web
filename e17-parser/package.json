{
  "name": "e17-parser",
  "version": "0.1.0",
  "description": "Ever17 (KID engine) LNK/SC3 scenario parser, disassembler and decompiler",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "exports": {
    ".": "./src/index.ts",
    "./lnk": "./src/lnk/parser.ts",
    "./sc3": "./src/sc3/chunks.ts",
    "./ir": "./src/ir/types.ts"
  },
  "bin": {
    "e17": "./src/cli.ts"
  },
  "scripts": {
    "e17": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "kid-contracts": "*"
  }
}
